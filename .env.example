# Server settings, read from the environment. Values shown are the dev defaults;
# production values live in deploy/kanban.service.

# Bind to all interfaces so other devices on the LAN can reach it.
KANBAN_BIND=0.0.0.0:8080

# SQLite database file (created on first run, along with its directory).
KANBAN_DB_PATH=data/kanban.db

# Log level for tracing (error|warn|info|debug|trace).
RUST_LOG=info
