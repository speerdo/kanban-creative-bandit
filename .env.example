# Copy to .env for local development. The production values live in the systemd unit.

# Bind to all interfaces so other devices on the LAN can reach it.
KANBAN_BIND=0.0.0.0:8080

# SQLite database file (created on first run).
KANBAN_DATABASE_URL=sqlite://data/kanban.db?mode=rwc

# Log level for tracing (error|warn|info|debug|trace).
RUST_LOG=info
